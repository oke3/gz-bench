{
  "name": "@ground-zero-llc/gz-bench",
  "version": "0.1.0",
  "description": "Standardized benchmark harness for AI coding-agent skills. Runs declarative JSON suites in isolated workspaces and scores deterministic filesystem/command assertions. Never calls an LLM.",
  "type": "module",
  "bin": {
    "gz-bench": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/validate.test.ts test/runner.test.ts test/report.test.ts test/cli.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Ground Zero LLC <hello@ground-zero.dev>",
  "publisher": "Ground Zero LLC",
    "name": "oke3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oke3/gz-bench.git"
  },
  "homepage": "https://github.com/oke3/gz-bench#readme",
  "bugs": {
    "url": "https://github.com/oke3/gz-bench/issues"
  },
  "keywords": [
    "benchmark",
    "harness",
    "ai-agents",
    "coding-agents",
    "testing"
  ],
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2"
  }
}
